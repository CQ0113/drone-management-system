VITE_APP_NAME="${APP_NAME}"

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=20
OLLAMA_TEMPERATURE=0.6
OLLAMA_TOP_P=0.92
SWARM_OLLAMA_PLAN_CACHE_SECONDS=10
SWARM_OLLAMA_STALE_FALLBACK_SECONDS=600
SWARM_NONBLOCKING_FORCE_REPLAN=true
SWARM_PATROL_ON_LLM_TIMEOUT=true
SWARM_PATROL_RADIUS=8
SWARM_SCAN_DETECTION_RADIUS=6
SWARM_MOVE_STEP=2.8
SWARM_SCAN_ORBIT_RADIUS=2.4
SWARM_SCAN_ORBIT_STEP=0.55
SWARM_BATTERY_MOVEMENT_UNITS_PER_PERCENT=8
SWARM_BATTERY_SCAN_DRAIN=1
SWARM_BATTERY_IDLE_DRAIN=0.03
SWARM_BATTERY_CHARGE_RATE=10
SWARM_BASE_CHARGE_UNTIL_PERCENT=60
SWARM_CACHE_PATROL_ON_REACH=false
SWARM_CACHE_PATROL_RADIUS=6
SWARM_CACHE_PATROL_REACH_THRESHOLD=1.2
SWARM_FRONTEND_TICK_TIMEOUT_MS=60000
SWARM_FRONTEND_TICK_COOLDOWN_MS=0
SWARM_FRONTEND_TICK_MODE=state_poll
SWARM_AI_LOOP_REQUEST_TIMEOUT=120
SWARM_AI_LOOP_SLEEP_MS=0

SWARM_USE_MCP_TOOLS=true
SWARM_USE_COMMAND_AGENT=false
SWARM_ALLOWED_DRONE_IDS=D1,D2,D3
SWARM_STALE_REANCHOR_MAX_STEP=10
MCP_DRONE_NODE_PATH="C:/Program Files/nodejs/node.exe"
MCP_DRONE_BRIDGE_TIMEOUT=25





